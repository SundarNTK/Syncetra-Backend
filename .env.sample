PORT=4010
NODE_ENV=development
APP_ENV=DEV

BASE_PATH_ADMIN=/api/v1/alarm/admin
BASE_PATH_USER=/api/v1/alarm/user

MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/group_alarm_db?retryWrites=true&w=majority

JWT_SECRET=change-me
JWT_EXPIRES_IN=7d
OTP_EXPIRY_MINUTES=5

# Secret for password-setup email links (defaults to JWT_SECRET + "-setup" if omitted)
PASSWORD_SETUP_SECRET=change-me-setup
PASSWORD_SETUP_EXPIRES=48h

# Email — choose ONE provider:
#
# Option A (recommended on Render free tier): Brevo HTTPS API
# 1. Sign up at https://www.brevo.com (free: 300 emails/day)
# 2. Settings → SMTP & API → Create API key
# 3. Senders → verify syncetra@gmail.com (one-click email confirmation)
# 4. Set BREVO_API_KEY on Render — works because it uses HTTPS, not blocked ports
BREVO_API_KEY=

# Option B (local dev or paid Render only): Gmail SMTP
# Render FREE tier blocks ports 587/465 — Gmail will timeout on free tier
GMAIL_USER=your.email@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
EMAIL_FROM=your.email@gmail.com

FIREBASE_SERVICE_ACCOUNT_PATH=./alert-message-app-firebase-adminsdk.json

# Comma-separated origins (localhost for PC + LAN IP for phone)
FRONTEND_URL=http://10.71.94.238:5173
# Optional: override logo URL in emails (defaults to FRONTEND_URL/Full_logo.png)
EMAIL_LOGO_URL=
CORS_ORIGIN=http://localhost:5173,http://YOUR_PC_IP:5173

# Optional: secret for public test API when APP_ENV=PROD
# TEST_ALARM_SECRET=your-secret-for-test-page
